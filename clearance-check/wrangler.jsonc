// Cloudflare Worker for MS-002 Clearance Check.
// This file lives in clearance-check/, so the Workers Builds "Root directory"
// must be clearance-check (set in Cloudflare, not in this file).
//
// Secrets (set on the Worker, never committed):
//   SUPABASE_ANON_KEY          moonshots anon key (public, sent to the browser)
//   SUPABASE_SERVICE_ROLE_KEY  moonshots service role key (server only)
//   RESEND_API_KEY             Resend key
// Optional vars: SITE_URL (needed for the cron sweep's result links), EMAIL_FROM.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearance-check",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "vars": {
    // moonshots project ONLY. Never uprfsmwbsvzuoiyfgtgx (production).
    "SUPABASE_URL": "https://kucwpmtkctafzkivuqtu.supabase.co"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true },
  // Required by `wrangler preview` (Workers Builds preview on non-production
  // branches). Assets and compatibility settings stay top level. Vars are not
  // inherited, so the moonshots URL is repeated here. No cron in previews, so a
  // preview never sends results emails on its own. Preview secrets
  // (SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY) are set on
  // the Worker, not in this file.
  "previews": {
    "vars": {
      // moonshots project ONLY. Never uprfsmwbsvzuoiyfgtgx (production).
      "SUPABASE_URL": "https://kucwpmtkctafzkivuqtu.supabase.co"
    },
    "observability": { "enabled": true }
  }
}
